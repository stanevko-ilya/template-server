# Временный HTTP-конфиг для ПЕРВИЧНОГО выпуска сертификата Let's Encrypt.
# Отдаёт ACME-челлендж и проксирует остальное на backend. После выпуска сертификата
# переключитесь на nginx.prod.conf.template (см. docker/README.md).
# Рендерится nginx-образом (${DOMAIN} из env).

resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        set $api_upstream backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_pass http://$api_upstream:3000;
    }
}
