# Продакшен-конфиг (TLS). Рендерится nginx-образом: ${DOMAIN} подставляется из env,
# nginx-переменные ($host, $remote_addr, $http_upgrade, ...) остаются как есть.

resolver 127.0.0.11 valid=5s ipv6=off;

# HTTP → HTTPS + ACME-челлендж Let's Encrypt
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    # API — round-robin по репликам backend (порт 3000)
    location /api/ {
        set $api_upstream backend;
        proxy_set_header Connection "";
        proxy_pass http://$api_upstream:3000;
    }

    # Socket.IO — порт 3001 (для мультиреплики: transports:['websocket'] на клиенте)
    location /socket.io/ {
        set $ws_upstream backend;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass http://$ws_upstream:3001;
    }
}
