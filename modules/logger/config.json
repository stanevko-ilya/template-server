{
    "UTC": false,
    "directory": "./logs",
    "format": {
        "file_name": "%DD%.%MM%.%YYYY%",
        "file_extension": "log",
        "log": "[%level%][%HH%:%MM%:%SS%]%text%"
    },
    "json_format": false,
    "save_logs": 180,

    "db_enabled": false,
    "db_levels": ["warn", "error"],
    "db_batch_size": 50,
    "db_flush_interval_ms": 2000
}
