# Скопируйте в packages/backend/.env для локальной разработки (dotenv читает .env из cwd процесса).

# ───────── Database (MongoDB) ─────────
DB_URL=mongodb://localhost:27017/mydb
# Опционально (компонентно) — переопределяют части подключения:
# MONGO_DB_NAME=
# MONGO_USER=
# MONGO_PASSWORD=
MONGO_REPLICA_SET=
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=5

# ───────── API ─────────
API_PORT=3000

# ───────── Sockets ─────────
SOCKETS_PORT=3001

# ───────── Health-сервер (процесс notifier) ─────────
HEALTH_PORT=3001

# ───────── Auth ─────────
# Обязателен, если есть методы/сокеты с auth. Без него токены не проверяются
# (используется случайный секрет на процесс — внешние токены не пройдут).
JWT_SECRET=your-secret-key-here

# ───────── Logger ─────────
# Включить Mongo-сток логгера:
# LOGGER_DB_ENABLED=false
# TTL логов в Mongo-стоке (если включён), дней:
# LOG_TTL_DAYS=180
# TTL записей notification-log (результаты фоновых джоб), дней:
# NOTIFICATION_LOG_TTL_DAYS=90

# ───────── Redis (cache + распределённые локи + rate limit) ─────────
# Пусто — прямое подключение к localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
# HA через Sentinel (если задано — direct host/port игнорируются):
REDIS_MASTER_NAME=
REDIS_SENTINELS_JSON=

# ───────── Swagger (документация на /api/docs?key=SERVICE_KEY) ─────────
SWAGGER_ENABLED=false
SERVICE_KEY=
# SWAGGER_TITLE=Template Server API

# ───────── Тесты / нагрузка ─────────
# true — отключает rate limit, увеличивает bodyLimit и т.п.
TEST_MODE=false

# ───────── TLS ─────────
# Терминируется внешним nginx + Let's Encrypt (см. docker/). В приложении SSL нет.
# LE_DOMAIN=example.com
# LE_EMAIL=admin@example.com
# LE_STAGING=0
