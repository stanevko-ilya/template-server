        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.3.0",
        "rate-limit-redis": "^4.2.0",
