# Database
DB_URL=mongodb://localhost:27017/mydb

# API
API_PORT=443

# Sockets
SOCKETS_PORT=444

# Auth
JWT_SECRET=your-secret-key-here

# SSL (off | file | letsencrypt)
SSL_MODE=off

# --- Режим file ---
# SSL_KEY_PATH=./SSL-certification/key.key
# SSL_CERT_PATH=./SSL-certification/certificate.crt
# SSL_CA_PATH=./SSL-certification/domain.cabundle

# --- Режим letsencrypt ---
# SSL_DOMAIN=example.com
# SSL_EMAIL=admin@example.com
# SSL_LETSENCRYPT_DIR=./ssl-certs
# SSL_LETSENCRYPT_STAGING=true
