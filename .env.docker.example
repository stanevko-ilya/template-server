# Env для контейнеров docker-compose. Скопируйте в .env.docker и заполните.

# ── Сервер ──
API_PORT=3000
SOCKETS_PORT=3001
HEALTH_PORT=3001

# ── MongoDB (single-node replica set rs0 из compose) ──
DB_URL=mongodb://mongo:27017/appdb
MONGO_REPLICA_SET=rs0
# Для продакшена с auth:
# DB_URL=mongodb://mongo:27017/appdb?authSource=admin
# MONGO_USER=root
# MONGO_PASSWORD=change-me-strong-password

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_MASTER_NAME=
REDIS_SENTINELS_JSON=

# ── Auth ──
# Обязателен, если есть методы/сокеты с auth (иначе токены не проверяются).
JWT_SECRET=change-me-secret

# ── Logger (Mongo-сток опционально) ──
# LOG_TTL_DAYS=180
# NOTIFICATION_LOG_TTL_DAYS=90

# ── Swagger (/api/docs?key=SERVICE_KEY) ──
SWAGGER_ENABLED=false
SERVICE_KEY=change-me-service-key
# SWAGGER_TITLE=Template Server API

# ── Тесты ──
TEST_MODE=false

# ── Let's Encrypt (только для docker-compose.prod.yml) ──
LE_DOMAIN=example.com
LE_EMAIL=admin@example.com
LE_STAGING=1
